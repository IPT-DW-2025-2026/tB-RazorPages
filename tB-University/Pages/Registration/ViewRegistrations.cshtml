@page
@model tB_University.Pages.Registration.ViewRegistrations

<h4>Ver inscrições</h4>
<p>
    <a asp-page="Create">Criar nova inscrição</a>
</p>

@foreach (var item in Model.ListaInscricoes) {
    <div class="row">
        <div class="col-3">Aluno @item.Student.Name</div>
        <div class="col-3">Curso @item.Course.Name</div>
    </div>
}
